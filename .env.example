META_WHATSAPP_SIGNUP_SESSION_TTL=15
META_WHATSAPP_VERIFY_TOKEN=

# Staging isolation. Keep communication disabled until the test assets,
# production-asset denylists and recipient allowlists are explicitly reviewed.
STAGING_EXPECTED_HOST=staging.sayaraforce.com
STAGING_EXPECTED_DB_DATABASE=sayaraforce_staging
STAGING_SCHEMA_BASELINE_APPROVED=false
TRUSTED_PROXIES=*
STAGING_PRODUCTION_APP_URL_DENYLIST=https://sayaraforce.com,https://app.sayaraforce.com
STAGING_PRODUCTION_DB_HOST_DENYLIST=
STAGING_META_PRODUCTION_WABA_ID_DENYLIST=
STAGING_META_PRODUCTION_PHONE_NUMBER_ID_DENYLIST=
STAGING_META_ALLOWED_WABA_IDS=
STAGING_META_ALLOWED_PHONE_NUMBER_IDS=
STAGING_ALLOW_LEGACY_COMPANY_RESOLUTION=false
STAGING_WHATSAPP_OUTBOUND_ENABLED=false
STAGING_SMS_OUTBOUND_ENABLED=false
STAGING_MESSAGE_RECIPIENT_ALLOWLIST=
STAGING_EMAIL_RECIPIENT_ALLOWLIST=
STAGING_EMAIL_DOMAIN_ALLOWLIST=
