# Meta WhatsApp / Embedded Signup. Values are examples or public identifiers;
# secrets and live tokens must only be supplied through the deployment environment.
META_APP_ID=925717083333434
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_WHATSAPP_CLOUD_API_CONFIG_ID=
META_WHATSAPP_BUSINESS_APP_CONFIG_ID=
META_WHATSAPP_EMBEDDED_SIGNUP_VERSION=v4
META_WHATSAPP_SESSION_INFO_VERSION=3
META_WHATSAPP_SIGNUP_SESSION_TTL=15
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_WABA_CALLBACK_OVERRIDE_ENABLED=false
META_WHATSAPP_WEBHOOK_CALLBACK_URL=
PUBLIC_REGISTRATION_ENABLED=false
SESSION_ENCRYPT=true
SANCTUM_EXPIRATION=60
SANCTUM_TOKEN_PREFIX=sf_
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PRIVATE_UPLOAD_DISK=local

# Platform-created, temporary WhatsApp opportunity scans. Disabled unless the
# environment is explicitly approved; this meter is independent of tenant plans.
QUICK_SCAN_ENABLED=false
QUICK_SCAN_ANALYSIS_CONTACT_LIMIT=500
QUICK_SCAN_LINK_TTL_HOURS=24
QUICK_SCAN_REPORT_TTL_HOURS=72
QUICK_SCAN_DECLINE_PURGE_DELAY_HOURS=24
QUICK_SCAN_CONSENT_POLICY_VERSION=2026-08-14

# Two-factor rollout: off -> audit -> required_admins. Never default production
# to required before its administrator inventory and recovery gate are approved.
TWO_FACTOR_ENFORCEMENT=off
SECURITY_STEP_UP_WINDOW_MINUTES=15
TWO_FACTOR_CHALLENGE_ATTEMPTS_PER_MINUTE=5

# Staging isolation. Keep communication disabled until the test assets,
# production-asset denylists and recipient allowlists are explicitly reviewed.
STAGING_EXPECTED_HOST=staging.sayaraforce.com
STAGING_EXPECTED_DB_DATABASE=sayaraforce_staging
STAGING_SCHEMA_BASELINE_APPROVED=false
TRUSTED_PROXIES=*
STAGING_PRODUCTION_APP_URL_DENYLIST=https://sayaraforce.com,https://app.sayaraforce.com
STAGING_PRODUCTION_DB_HOST_DENYLIST=
STAGING_META_PRODUCTION_WABA_ID_DENYLIST=
STAGING_META_PRODUCTION_PHONE_NUMBER_ID_DENYLIST=
STAGING_META_ALLOWED_WABA_IDS=
STAGING_META_ALLOWED_PHONE_NUMBER_IDS=
STAGING_ALLOW_LEGACY_COMPANY_RESOLUTION=false
STAGING_WHATSAPP_OUTBOUND_ENABLED=false
AI_METERING_HMAC_KEY=
AI_MAX_ANALYSIS_RUNS_PER_CUSTOMER_PERIOD=100

# Provider-neutral commercial billing. Disabled is the safe default. Staging
# may explicitly use the in-app fake provider; Stripe accepts test keys only in
# the current release and never treats a browser redirect as payment proof.
BILLING_PROVIDER=disabled
BILLING_MODE=test
BILLING_CHECKOUT_ENABLED=false
BILLING_FAILED_PAYMENT_GRACE_DAYS=7
BILLING_FAKE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
STRIPE_API_VERSION=2026-07-29.dahlia
STRIPE_WEBHOOK_TOLERANCE=300

# Provider-neutral mobile notification delivery. Fake is local/staging safe;
# external delivery remains fail-closed until provider credentials are approved.
PUSH_NOTIFICATION_DRIVER=fake
PUSH_EXTERNAL_DELIVERY_ENABLED=false
STAGING_SMS_OUTBOUND_ENABLED=false
STAGING_MESSAGE_RECIPIENT_ALLOWLIST=
STAGING_EMAIL_RECIPIENT_ALLOWLIST=
STAGING_EMAIL_DOMAIN_ALLOWLIST=
